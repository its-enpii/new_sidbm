{
    "name": "enpii/sidbm-assistant",
    "description": "SIDBM-side adapter for the AI in-app assistant (session token issuer, HMAC-verified tool dispatcher, Vue widget, RBAC). Orchestrator/RAG/LLM live in a separate service.",
    "type": "laravel-package",
    "license": "proprietary",
    "keywords": ["sidbm", "assistant", "ai", "tool-calling", "sse", "hmac"],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "inertiajs/inertia-laravel": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Enpii\\SidbmAssistant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Enpii\\SidbmAssistant\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Enpii\\SidbmAssistant\\SidbmAssistantServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}