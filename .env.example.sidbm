APP_NAME="SIDBM Next"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=3306
PLATFORM_DB_DATABASE=sidbm_platform
PLATFORM_DB_USERNAME=root
PLATFORM_DB_PASSWORD=

# Runtime tenant connection is replaced from database_shards.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_DATABASE=sidbm_shard_placeholder
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=

# Example only. Replace with secret manager adapter in production.
TENANCY_SHARD_CREDENTIALS_JSON='{"shard-01":{"username":"sidbm_app","password":"secret"}}'
TENANCY_ROUTE_PARAMETER=tenant
TENANCY_ALLOW_HEADER=false
TENANCY_HEADER=X-Tenant-Code

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
