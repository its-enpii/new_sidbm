#!/bin/sh

echo "🔍 Running pre-commit quality checks..."

# 1. Check PHP Code Style (Pint)
echo "🎨 Checking PHP Code Style (Pint)..."
php vendor/bin/pint --test
if [ $? -ne 0 ]; then
    echo "❌ Code style check failed! Please run 'php vendor/bin/pint' to fix formatting."
    exit 1
fi

# 2. Run PHPUnit Unit Tests
echo "🧪 Running Unit Tests..."
php artisan test --testsuite=Unit
if [ $? -ne 0 ]; then
    echo "❌ Unit tests failed! Commit aborted."
    exit 1
fi

echo "✅ Pre-commit checks passed!"