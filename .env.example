APP_NAME="SIDBM Next"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:64080
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

APP_PORT=8080
VITE_PORT=5174
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6379

# === sidbm-assistant (in-process) ===
# Chat LLM (OpenAI-compatible). Required.
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=antigravity/gemini-3.5-flash-low
LLM_TIMEOUT=120

# Embedding model. Points at the in-cluster ollama service by default.
# Override with http://host.docker.internal:11434/v1 to use Ollama on the host.
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT=120
EMBEDDING_DIM=768

# sidbm-assistant tunables
ASSISTANT_PERSONA_SLUG=
ASSISTANT_SYSTEM_ACTOR_USER_ID=0
ASSISTANT_WIDGET_ENABLED=true

# enpii/assistant RAG store (Postgres + pgvector). Hybrid with MySQL — only
# ai_* tables live here; everything else stays in MySQL.
RAG_DB_CONNECTION=pgsql
RAG_DB_HOST=postgres
RAG_DB_PORT=5432
RAG_DB_DATABASE=assistant
RAG_DB_USERNAME=assistant
RAG_DB_PASSWORD=assistant

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug

DB_CONNECTION=platform
PLATFORM_DB_HOST=mysql
PLATFORM_DB_PORT=3306
PLATFORM_DB_DATABASE=sidbm_platform
PLATFORM_DB_USERNAME=sidbm
PLATFORM_DB_PASSWORD=sidbm

TENANT_DB_HOST=mysql
TENANT_DB_PORT=3306
TENANT_DB_DATABASE=sidbm_shard_local
TENANT_DB_USERNAME=sidbm
TENANT_DB_PASSWORD=sidbm
TENANT_TEST_DB_DATABASE=sidbm_shard_test
PLATFORM_TEST_DB_DATABASE=sidbm_platform_test

TENANCY_SHARD_CREDENTIALS_JSON='{"local":{"username":"sidbm","password":"sidbm"},"test":{"username":"sidbm","password":"sidbm"}}'
TENANCY_ROUTE_PARAMETER=tenant
TENANCY_ALLOW_HEADER=true
TENANCY_HEADER=X-Tenant-Code
TENANCY_LOCAL_TENANT=local
REGIONAL_CODE_API_URL=https://api.kodewilayah.web.id
REGIONAL_CODE_API_TIMEOUT=10

# Legacy SIDBM source (read-only intent). Password only in local .env — never commit.
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# Evolution API (global). Instance per tenant: sidbm-{tenantId}
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_TIMEOUT=15
EVOLUTION_INSTANCE_PREFIX=sidbm

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MYSQL_ROOT_PASSWORD=root
ENCOMPLETION_PUBLIC_URL=

# Tripay (platform billing)
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MODE=sandbox
TRIPAY_DEFAULT_METHOD=QRIS2
# TRIPAY_CALLBACK_URL=https://your-domain/tripay/callback

# Duitku (platform billing)
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_MODE=sandbox
DUITKU_DEFAULT_METHOD=SP
# DUITKU_CALLBACK_URL=https://your-domain/duitku/callback

# Xendit (platform billing)
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_MODE=sandbox
XENDIT_DEFAULT_METHOD=QRIS
# XENDIT_CALLBACK_URL=https://your-domain/xendit/callback

# Bump when migrations change schema OR the frontend asset bundle changes
# (consumed by app/Http/Middleware/HandleInertiaRequests::version())
APP_VERSION=2026-08-05-pgvector-ollama
