APP_NAME="SIDBM Next"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

APP_PORT=8080
VITE_PORT=5174
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6379

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug

DB_CONNECTION=platform
PLATFORM_DB_HOST=mysql
PLATFORM_DB_PORT=3306
PLATFORM_DB_DATABASE=sidbm_platform
PLATFORM_DB_USERNAME=sidbm
PLATFORM_DB_PASSWORD=sidbm

TENANT_DB_HOST=mysql
TENANT_DB_PORT=3306
TENANT_DB_DATABASE=sidbm_shard_local
TENANT_DB_USERNAME=sidbm
TENANT_DB_PASSWORD=sidbm
TENANT_TEST_DB_DATABASE=sidbm_shard_test
PLATFORM_TEST_DB_DATABASE=sidbm_platform_test

# Legacy SIDBM source (read-only intent). Password only in local .env — never commit.
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

TENANCY_SHARD_CREDENTIALS_JSON='{"local":{"username":"sidbm","password":"sidbm"},"test":{"username":"sidbm","password":"sidbm"}}'
TENANCY_ROUTE_PARAMETER=tenant
TENANCY_ALLOW_HEADER=false
TENANCY_HEADER=X-Tenant-Code
TENANCY_LOCAL_TENANT=local
REGIONAL_CODE_API_URL=https://api.kodewilayah.web.id
REGIONAL_CODE_API_TIMEOUT=10

# Evolution API (global). Instance per tenant: sidbm-{tenantId}
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_TIMEOUT=15
EVOLUTION_INSTANCE_PREFIX=sidbm

# Assistant orchestrator (optional) — brain + chat + RAG; SIDBM = tool adapter only
ASSISTANT_ORCHESTRATOR_BASE_URL=
ASSISTANT_ORCHESTRATOR_PUBLIC_URL=
ASSISTANT_SHARED_SECRET=
ASSISTANT_WIDGET_ENABLED=false
ASSISTANT_TIMEOUT=10
ASSISTANT_SIG_MAX_SKEW_MS=300000
# URL orchestrator pakai untuk callback tool ke SIDBM (reachable dari proses orchestrator)
# Host orchestrator + Docker SIDBM: http://127.0.0.1:8080
ASSISTANT_ADAPTER_BASE_URL=
# Optional default persona slug (ariel / cs); empty = orchestrator default
ASSISTANT_PERSONA_SLUG=
# For multi-tenant single-host tool callbacks, set true and register tools with X-Tenant-Code
# TENANCY_ALLOW_HEADER=true

CACHE_STORE=redis
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MYSQL_ROOT_PASSWORD=root

# Tripay (platform billing)
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MODE=sandbox
TRIPAY_DEFAULT_METHOD=QRIS2
# TRIPAY_CALLBACK_URL=https://your-domain/tripay/callback
